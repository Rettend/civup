{
  "name": "@civup/analyzer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "bin": {
    "civup": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "civup": "bun src/cli.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=../../coverage/analyzer",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@civup/civ6-save-metadata": "workspace:*"
  }
}
