{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civup-activity",
  "account_id": "33333333333333333333333333333333",
  "compatibility_date": "2025-01-01",
  "main": "src/server/index.ts",
  "vars": {
    "ACTIVITY_PUBLIC_ORIGIN": "https://activity.example.invalid",
    "ALLOWED_DISCORD_GUILD_ID": "4444444444444444444",
    "DISCORD_CLIENT_ID": "3333333333333333333"
  },
  "services": [
    {
      "binding": "BOT",
      "service": "civup-bot"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
