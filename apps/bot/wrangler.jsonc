{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civup-bot",
  "account_id": "44ca252afa99dc6d23fe013ebffefdee",
  "main": "src/index.ts",
  "keep_vars": true,
  "compatibility_date": "2025-02-19",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.woff2"],
      "fallthrough": false
    }
  ],

  "vars": {
    "ACTIVITY_PUBLIC_ORIGIN": "https://activity-1.example.invalid",
    "ALLOWED_DISCORD_GUILD_ID": "9222089226492061636",
    "DISCORD_APPLICATION_ID": "9606055819354065576",
    "DISCORD_PUBLIC_KEY": "REPLACE_WITH_64_CHARACTER_DISCORD_PUBLIC_KEY"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "Activity",
        "class_name": "Activity"
      },
      {
        "name": "SessionDO",
        "class_name": "SessionDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": ["SessionDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["Activity"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "civup",
      "database_id": "13c1d9b7-3bd2-42d2-8c6a-a0402e58fcad",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3fadbf4b3cd542f9d35ad6ca2a29e456"
    }
  ],

  "r2_buckets": [
    {
      "binding": "AUTOSAVE_UPLOADS",
      "bucket_name": "civup-autosave-uploads"
    }
  ],

  "triggers": {
    "crons": [
      "0 * * * *", // every hour
      "*/15 * * * *", // every 15 minutes
      "0 0 * * *" // every day at 0:00 UTC
    ]
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
