{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civup-bot",
  "account_id": "44ca252afa99dc6d23fe013ebffefdee",
  "main": "src/index.ts",
  "keep_vars": true,
  "compatibility_date": "2025-02-19",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "BOT_HOST": "https://civup-bot.rettend.workers.dev",
    "ENABLE_DEBUG_LOBBY_FILL": "1"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      },
      {
        "name": "SessionDO",
        "class_name": "SessionDO"
      },
      {
        "name": "State",
        "class_name": "State"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Main"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["State"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SessionDO"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "civup",
      "database_id": "13c1d9b7-3bd2-42d2-8c6a-a0402e58fcad",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3fadbf4b3cd542f9d35ad6ca2a29e456"
    }
  ],

  "triggers": {
    "crons": [
      "0 * * * *", // every hour
      "*/2 * * * *", // every 2 minutes
      "0 0 * * *" // every day at 0:00 UTC
    ]
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
