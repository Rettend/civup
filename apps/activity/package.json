{
  "name": "civup-activity",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run preview",
    "dev:new": "bun run build && bun run preview",
    "dev:live": "bun ../../scripts/cloudflare-worker.ts live activity --target standard",
    "build": "bun ../../scripts/cloudflare-worker.ts build activity --target standard --mode development",
    "build:prod": "bun ../../scripts/cloudflare-worker.ts build activity --target standard",
    "build:ppl": "bun ../../scripts/cloudflare-worker.ts build activity --target ppl",
    "preview": "bun ../../scripts/cloudflare-worker.ts preview activity --target standard",
    "test": "vp test --config vitest.config.ts --run",
    "test:coverage": "vp test --config vitest.config.ts --run --coverage",
    "test:ui": "vp test --config vitest.config.ts --ui --api.port 51299",
    "check": "tsc --noEmit",
    "items:normalize-icons": "bun ./scripts/normalize-bbg-item-icons.ts",
    "portraits:webp": "bun ./scripts/convert-leaders-full-to-webp.ts --delete",
    "portraits:normalize-icons": "bun ./scripts/normalize-leader-grid-icons.ts",
    "deploy": "bun ../../scripts/cloudflare-worker.ts deploy activity --target standard",
    "deploy:prod": "bun run deploy",
    "deploy:ppl": "bun ../../scripts/cloudflare-worker.ts deploy activity --target ppl",
    "secret:bulk:prod": "bun ../../scripts/upload-worker-secrets.ts activity .prod.secrets --target standard"
  },
  "dependencies": {
    "@civup/game": "workspace:*",
    "@civup/rating": "workspace:*",
    "@civup/session": "workspace:*",
    "@civup/utils": "workspace:*",
    "@discord/embedded-app-sdk": "^2.4.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@solid-primitives/scheduled": "2.0.0-next.2",
    "@solid-primitives/storage": "5.0.0-next.4",
    "@solidjs/router": "2.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.13",
    "@zip.js/zip.js": "^2.8.11",
    "partysocket": "^1.1.3",
    "solid-js": "2.0.0-rc.13",
    "unocss-merge": "^0.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "4.20260206.0",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/ph": "^1.2.2",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@unocss/reset": "66.10.5",
    "happy-dom": "20.14.5",
    "unocss": "66.10.5",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.147.0"
  }
}
