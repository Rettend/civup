{
  "name": "civup-activity",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.7",
  "scripts": {
    "dev": "bun run preview",
    "dev:new": "bun run build && bun run preview",
    "dev:live": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build --mode development",
    "build:prod": "vite build",
    "build:ppl": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.ppl.json vite build",
    "preview": "wrangler dev --config wrangler.json --port 5173 --show-interactive-dev-session=false --log-level log",
    "test": "bun test --preload ./tests/setup-dom.ts tests",
    "test:coverage": "bun test --preload ./tests/setup-dom.ts tests --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "check": "tsgo --noEmit",
    "items:normalize-icons": "bun ./scripts/normalize-bbg-item-icons.ts",
    "portraits:webp": "bun ./scripts/convert-leaders-full-to-webp.ts --delete",
    "portraits:normalize-icons": "bun ./scripts/normalize-leader-grid-icons.ts",
    "deploy": "bun run build:prod && wrangler deploy --config wrangler.json",
    "deploy:prod": "bun run deploy",
    "deploy:ppl": "bun run build:ppl && wrangler deploy --config wrangler.ppl.json",
    "secret:bulk:prod": "wrangler secret bulk .prod.secrets --config wrangler.json"
  },
  "dependencies": {
    "@civup/game": "workspace:*",
    "@civup/rating": "workspace:*",
    "@civup/session": "workspace:*",
    "@civup/utils": "workspace:*",
    "@discord/embedded-app-sdk": "^2.4.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/storage": "^4.3.4",
    "@solidjs/router": "^0.16.1",
    "@zip.js/zip.js": "^2.8.11",
    "partysocket": "^1.1.3",
    "solid-js": "^1.9.7",
    "unocss-merge": "^0.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20260206.0",
    "@happy-dom/global-registrator": "^20.6.1",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/ph": "^1.2.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@unocss/reset": "^66.6.0",
    "unocss": "^66.6.0",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "wrangler": "^4.22.0"
  }
}
