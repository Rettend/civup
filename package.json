{
  "name": "civup",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:new": "bun scripts/dev.ts --rebuild-activity",
    "dev:live": "bun scripts/dev.ts --activity-live",
    "test": "bun run test:tools && bun run --filter '*' test",
    "test:tools": "bun test ./tests && node --test tests/player-copy-plugin.node.ts tests/tooling-config.node.ts",
    "test:cloudflare:local": "bun --no-env-file tests/cloudflare-local.node.ts --run",
    "test:tools:coverage": "bun test ./tests --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage/tools && node --test tests/player-copy-plugin.node.ts tests/tooling-config.node.ts",
    "test:e2e": "bun run --filter civup-bot test:e2e",
    "test:cov": "bun run test:tools:coverage && bun run --filter '*' test:coverage",
    "test:ui": "bun run --filter civup-activity test:ui",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "bun run check:copy && bun run --filter '*' check && bun run check:tools",
    "check:copy": "bun scripts/check-player-copy.ts",
    "check:tools": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p apps/bot/tsconfig.scripts.json",
    "a:dev": "bun run --filter civup-activity dev",
    "a:dev:new": "bun run --filter civup-activity dev:new",
    "a:dev:live": "bun run --filter civup-activity dev:live",
    "a:build": "bun run --filter civup-activity build",
    "a:deploy": "bun run --filter civup-activity deploy",
    "a:deploy:prod": "bun run --filter civup-activity deploy:prod",
    "bot:dev": "bun run --filter civup-bot dev",
    "bot:deploy": "bun run --filter civup-bot deploy",
    "bot:deploy:prod": "bun run --filter civup-bot deploy:prod",
    "bot:register": "bun run --filter civup-bot register:dev",
    "bot:register:prod": "bun run --filter civup-bot register:prod",
    "bot:test:e2e": "bun run --filter civup-bot test:e2e",
    "bot:test:capacity": "bun run --filter civup-bot test:capacity",
    "bot:secrets:prod": "bun run --filter civup-bot secret:bulk:prod",
    "a:secrets:prod": "bun run --filter civup-activity secret:bulk:prod",
    "bot:d1:create": "bun run --filter civup-bot d1:create",
    "bot:kv:create": "bun run --filter civup-bot kv:create",
    "bot:r2:create": "bun run --filter civup-bot r2:create",
    "bot:kv:local": "bun run --filter civup-bot kv:local",
    "bot:backfill:civ-leaderboard": "bun run --filter civup-bot backfill:civ-leaderboard",
    "bot:backfill:civ-leaderboard:prod:estimate": "bun run --filter civup-bot backfill:civ-leaderboard estimate --remote --repair",
    "bot:backfill:civ-leaderboard:prod:preview": "bun run --filter civup-bot backfill:civ-leaderboard preview --remote --repair",
    "bot:backfill:civ-leaderboard:prod:apply": "bun run --filter civup-bot backfill:civ-leaderboard apply --remote --repair --execute",
    "bot:backfill:player-civs": "bun run --filter civup-bot backfill:player-civs",
    "bot:seed:dev:leaders": "bun run --filter civup-bot seed:dev:leaders",
    "bot:l:migrate": "bun run --filter civup-bot l:migrate",
    "bot:r:migrate": "bun run --filter civup-bot r:migrate",
    "db:generate": "bun run --filter @civup/db generate",
    "db:studio": "bun run --filter @civup/db studio",
    "tunnel": "cloudflared --config cloudflared.dev.yml tunnel run civup-dev",
    "deploy:prod": "bun scripts/deploy.ts",
    "deploy:prod:full": "bun scripts/deploy.ts --register",
    "cf:usage:snapshot": "bun scripts/cloudflare-usage.ts snapshot",
    "cf:usage:diff": "bun scripts/cloudflare-usage.ts diff",
    "civup": "bun packages/civup-analyzer/src/cli.ts",
    "autosave:parse": "bun scripts/autosave-parse.ts",
    "clean": "bun scripts/clean.ts",
    "update": "taze latest -wr"
  },
  "devDependencies": {
    "@cloudflare/config": "0.23.0",
    "@cloudflare/workers-types": "4.20260206.0",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@unocss/eslint-plugin": "66.10.5",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "better-sqlite3": "^12.6.2",
    "cf": "1.0.0-beta.12",
    "discord-api-types": "^0.38.38",
    "eslint-plugin-solid": "0.18.1",
    "oxc-parser": "0.151.0",
    "taze": "^19.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite@>=8": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "5.0.1"
  }
}
